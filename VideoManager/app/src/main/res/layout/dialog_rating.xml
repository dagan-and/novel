<?xml version="1.0" encoding="utf-8"?>
<!--
    롱클릭 시 표시되는 별점 입력 다이얼로그 레이아웃
    ┌─────────────────────────────┐
    │  🎬 파일명.mp4               │
    │  ──────────────────────────│
    │       ★★★★☆               │
    │         4.0 / 5.0           │
    │  ──────────────────────────│
    │   [취소]         [저장]      │
    └─────────────────────────────┘
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="4dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- 영상 파일명 -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingMultiplier="1.1"
        android:paddingBottom="14dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:background="@drawable/bg_dialog_rating_panel">

        <!-- 별점 바 (큰 사이즈) -->
        <RatingBar
            android:id="@+id/rating_bar_dialog"
            style="@style/Widget.AppCompat.RatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:rating="0"
            android:progressTint="@color/color_accent"
            android:progressBackgroundTint="#CFD8DC" />

        <!-- 현재 선택된 점수 숫자 -->
        <TextView
            android:id="@+id/tv_dialog_rating_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="22sp"
            android:textColor="@color/color_accent"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:text="★ 0.0 / 5.0" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0.5점 단위로 저장됩니다"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginTop="12dp" />

</LinearLayout>
