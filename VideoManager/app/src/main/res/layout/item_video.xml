<?xml version="1.0" encoding="utf-8"?>
<!--
    영상 목록 아이템 레이아웃
    ┌──────────────────────────────────────────────────────────┐
    │ [썸네일]  파일 이름 (2줄 ellipsize)                       │
    │           ⏱ 00:00  ·  XX.X MB                           │
    │           yyyy-MM-dd                                     │
    │           ★★★★☆  ★ 4.0                                  │
    └──────────────────────────────────────────────────────────┘
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- ── 최근 재생 강조 스트라이프 ──────────────── -->
        <View
            android:id="@+id/recently_played_stripe"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/color_primary"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="10dp">

        <!-- ── 썸네일 ──────────────────────────────────── -->
            <ImageView
                android:id="@+id/iv_thumbnail"
            android:layout_width="122dp"
            android:layout_height="84dp"
            android:scaleType="centerCrop"
            android:background="#243B53"
            android:contentDescription="영상 썸네일" />

        <!-- ── 우측 정보 영역 ──────────────────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <!-- 최근 재생 배지 -->
            <TextView
                android:id="@+id/tv_recently_played_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_recently_played_badge"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="최근 재생"
                android:textColor="@color/color_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 파일 이름 -->
            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1F2933"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15" />

            <!-- 재생시간 · 용량 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#52606D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ·  "
                    android:textColor="#90A4AE"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#52606D" />

            </LinearLayout>

            <!-- 수정 날짜 -->
            <TextView
                android:id="@+id/tv_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#90A4AE"
                android:layout_marginTop="2dp" />

            <!-- 별점 영역 -->
            <LinearLayout
                android:id="@+id/rating_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/bg_rating_panel"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="별점 변경">

                <!-- RatingBar (0.5 단위, 최대 5점) -->
                <RatingBar
                    android:id="@+id/rating_bar"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="0.5"
                    android:rating="0"
                    android:isIndicator="true"
                    android:progressTint="#FFA000"
                    android:progressBackgroundTint="#CFD8DC" />

                <!-- 별점 숫자 텍스트 (★ 4.5) -->
                <TextView
                    android:id="@+id/tv_rating_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 0.0"
                    android:textSize="12sp"
                    android:textColor="#FFA000"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
